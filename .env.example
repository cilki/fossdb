# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
#
# Nothing here is mandatory: the server starts with all defaults.
#
# Collector and worker API keys are NOT configured here. They live in the
# database and are managed over the admin socket:
#
#   fossdb admin api-key create --role collector --label $(hostname)
#   fossdb admin api-key create --role worker    --label $(hostname)
#   fossdb admin api-key list
#   fossdb admin api-key revoke <key-id>
#
# A fresh server has no keys, so collectors and workers get 401 until you
# create one. The resulting key goes in the *collector's* or *worker's*
# environment as COLLECTOR_API_KEY / WORKER_API_KEY respectively.

DATABASE_PATH=./data/fossdb.db
SERVER_PORT=3000
BIND_ADDRESS=0.0.0.0

# Internal APIs for collectors and workers. These are guarded only by an API
# key, so they bind loopback by default; widen this only deliberately.
COLLECTOR_PORT=3001
WORKER_PORT=3002
INTERNAL_BIND_ADDRESS=127.0.0.1

# Absolute origin this deployment is reachable at. Feed documents must contain
# absolute URLs, and the server cannot infer its own public origin from a
# request when it sits behind a reverse proxy.
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
#
# There is no password and no email. An account is a single random id that
# serves as both identifier and credential, and which also appears in the
# account's feed URLs.
#
# Registration is unauthenticated and unthrottled, so accounts that never
# subscribe to anything are reaped. Note the rule applies continuously: an
# established account that removes its last subscription also becomes
# eligible for deletion.

ACCOUNT_GRACE_HOURS=4
ACCOUNT_PURGE_INTERVAL_SECS=300

# ---------------------------------------------------------------------------
# Admin socket
# ---------------------------------------------------------------------------
#
# Unix socket for `fossdb admin ...`. Access control is the socket's
# filesystem permissions (created 0660), so place it in a directory only
# administrators can traverse.

ADMIN_SOCKET_PATH=/run/fossdb/admin.sock

# ---------------------------------------------------------------------------
# Retention and collection
# ---------------------------------------------------------------------------

TIMELINE_RETENTION_DAYS=90
COLLECTOR_INTERVAL_HOURS=1

# Optional: raises libraries.io rate limits.
LIBRARIES_IO_API_KEY=

# OSV ecosystems whose security advisories the collector ingests
# (comma-separated). npm, PyPI, Go, Maven, Packagist, NuGet and RubyGems
# match the packages the libraries.io collector stores.
OSV_ECOSYSTEMS=crates.io

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

RUST_LOG=info
